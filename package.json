{
  "name": "simulation-of-boring-things",
  "version": "0.1.570",
  "description": "A first-person leisure-centre pool plant engineering game.",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "vp test run --passWithNoTests",
    "test:watch": "vp test",
    "build": "npm run typecheck && node scripts/build.ts",
    "preview": "vp preview --host 127.0.0.1",
    "check": "vp check",
    "manual": "MANUAL=1 vp test run scripts/build-manual.test.ts && latexmk -lualatex -interaction=nonstopmode -halt-on-error -cd build/manual/manual.tex",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\""
  },
  "type": "module",
  "dependencies": {
    "@preact/signals-core": "1.14.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@statelyai/graph": "2.6.0",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@viz-js/viz": "3.31.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  }
}
